{
  "name": "jobdesk-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "next": "16.4.4",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.1.0",
    "tldts": "^7.4.19",
    "unpdf": "^1.3.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
