# All state is local and ignored by Git. Set an absolute path to relocate it.
JOBDESK_DATA_DIR=.local
JOBDESK_BASE_URL=http://127.0.0.1:3000
# Optional: use an installed browser instead of Playwright Chromium.
# PLAYWRIGHT_CHANNEL=msedge
# Optional JSON fact-ranking service. See README for its small HTTP contract.
# No provider is required. Credentials are server-only, never saved in the profile.
AI_RANKING_URL=
AI_RANKING_KEY=
